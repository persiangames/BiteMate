# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://bitemate:bitemate_secret@localhost:5432/bitemate?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS (include production domain when deploying)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://www.bitemate.ir,https://bitemate.ir

# Public site URL (used in emails and links)
APP_NAME=BiteMate
APP_PUBLIC_URL=https://www.bitemate.ir

# Bootstrap the first platform admin by matching this login email
ADMIN_BOOTSTRAP_EMAIL=

# SMS (console = log only; set kavenegar or melipayamak in production)
SMS_PROVIDER=console
SMS_SENDER=BiteMate
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_API_KEY_HEADER=Authorization
SMS_HTTP_API_KEY=

# Email (console = log only; set smtp in production)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@bitemate.ir
EMAIL_FROM_NAME=BiteMate
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=debug

# JWT
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bitemate
JWT_AUDIENCE=bitemate-app
JWT_ISSUER=bitemate
JWT_AUDIENCE=bitemate-app

# Firebase Admin (optional — required for Google/Facebook login)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OTP
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Live Location
LIVE_LOCATION_TTL_SECONDS=300
LIVE_LOCATION_UPDATE_INTERVAL_SECONDS=30
REDIS_GEO_KEY=bitemate:geo:live

# Storage (local dev default; set STORAGE_PROVIDER=s3 for AWS)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MongoDB (chat)
MONGODB_URI=mongodb://localhost:27017/bitemate

# Wallet / Payments
WALLET_ENCRYPTION_KEY=dev-only-wallet-encryption-key-32chars!!
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_KEY=
WALLET_CACHE_TTL_SECONDS=60
WALLET_DEPOSIT_FEE_PERCENT=2.5
WALLET_WITHDRAW_FEE_PERCENT=1
WALLET_WITHDRAW_FEE_FLAT=1
WALLET_TRANSFER_FEE_PERCENT=0.5
WALLET_CRYPTO_WITHDRAW_FEE_FLAT=2
WALLET_ESCROW_FEE_PERCENT=1.5

# Security / Monitoring
TRUST_PROXY=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=8
LOGIN_FAIL_LIMIT=8
JSON_BODY_LIMIT=1mb
SENTRY_DSN=
