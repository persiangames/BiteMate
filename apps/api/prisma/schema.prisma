  meetup      FoodMeetup         @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  inviterId   String             @map("inviter_id")
  inviter     User               @relation("MeetupInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String             @map("invitee_id")
  invitee     User               @relation("MeetupInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status      MeetupInviteStatus @default(PENDING)
  expiresAt   DateTime           @map("expires_at")
  respondedAt DateTime?          @map("responded_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([meetupId, inviteeId])
  @@index([inviteeId, status])
  @@index([inviterId, createdAt(sort: Desc)])
  @@map("meetup_invites")
