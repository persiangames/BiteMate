  bankName                String            @map("bank_name")
  accountHolderName       String            @map("account_holder_name")
  country                 String
  encryptedAccountNumber  String            @map("encrypted_account_number")
  encryptedRoutingNumber  String?           @map("encrypted_routing_number")
  last4                   String            @map("last4")
