model MeetupRoom {
  id        String           @id @default(uuid())
  meetupId  String           @unique @map("meetup_id")
  meetup    FoodMeetup       @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  status    MeetupRoomStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  closedAt  DateTime?        @map("closed_at")

  members  MeetupRoomMember[]
  messages MeetupRoomMessage[]

  @@map("meetup_rooms")
}

model MeetupRoomMember {
  id       String     @id @default(uuid())
  roomId   String     @map("room_id")
  room     MeetupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String     @map("user_id")
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now()) @map("joined_at")

  @@unique([roomId, userId])
  @@index([userId])
  @@map("meetup_room_members")
}

model MeetupRoomMessage {
  id        String     @id @default(uuid())
  roomId    String     @map("room_id")
  room      MeetupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
