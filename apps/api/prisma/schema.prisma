}

model CryptoDepositAddress {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset             CryptoAsset
  address           String
  providerReference String?     @map("provider_reference")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@unique([userId, asset])
  @@index([address])
  @@map("crypto_deposit_addresses")
}

model WalletTransaction {
  id                  String                  @id @default(uuid())
  userId              String                  @map("user_id")
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                WalletTransactionType
  status              WalletTransactionStatus @default(PENDING)
  amount              Decimal                 @db.Decimal(14, 2)
  fee                 Decimal                 @default(0) @db.Decimal(14, 2)
  netAmount           Decimal                 @map("net_amount") @db.Decimal(14, 2)
  currency            String                  @default("USD")
  cryptoAsset         CryptoAsset?            @map("crypto_asset")
  cryptoAmount        Decimal?                @map("crypto_amount") @db.Decimal(18, 8)
  provider            PaymentProvider         @default(INTERNAL)
  providerReferenceId String?                 @map("provider_reference_id")
  counterpartyUserId  String?                 @map("counterparty_user_id")
  description         String?
  metadata            Json?
  escrowId            String?                 @map("escrow_id")
  idempotencyKey      String?                 @unique @map("idempotency_key")
  completedAt         DateTime?               @map("completed_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, type])
  @@map("wallet_transactions")
}

model EscrowHold {
  id            String       @id @default(uuid())
  payerId       String       @map("payer_id")
  payer         User         @relation("EscrowPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payeeId       String       @map("payee_id")
  payee         User         @relation("EscrowPayee", fields: [payeeId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(14, 2)
  fee           Decimal      @default(0) @db.Decimal(14, 2)
  currency      String       @default("USD")
  status        EscrowStatus @default(HELD)
  referenceType String       @map("reference_type")
  referenceId   String       @map("reference_id")
  releaseNote   String?      @map("release_note")
  heldAt        DateTime     @default(now()) @map("held_at")
  releasedAt    DateTime?    @map("released_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([payerId, status])
  @@index([payeeId, status])
  @@index([referenceType, referenceId])
  @@map("escrow_holds")
}

model FraudLog {
