# API base URL (used in production builds; dev uses Vite proxy)
VITE_API_BASE_URL=http://localhost:3000/api

# Firebase Web SDK (optional — required for Google/Facebook login)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Mapbox (optional). Nearby uses OpenStreetMap when this is empty.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_LIVE_LOCATION_INTERVAL_SECONDS=30
