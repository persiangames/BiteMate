# API base URL (used in production builds; dev uses Vite proxy)
VITE_API_BASE_URL=https://www.bitemate.ir/api

# Optional: override when uploads are served from a different host than the web app.
# Defaults to VITE_API_BASE_URL + /uploads (e.g. https://www.bitemate.ir/api/uploads).
# VITE_UPLOADS_BASE_URL=https://www.bitemate.ir/api/uploads

# Firebase Web SDK (required for Google login)
# Create a project at https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Mapbox (optional). Nearby uses OpenStreetMap when this is empty.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_LIVE_LOCATION_INTERVAL_SECONDS=30
